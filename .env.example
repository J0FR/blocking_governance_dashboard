# Copy to .env and fill in. Only needed to run the queries from this machine
# (the dashboard itself works with uploaded CSV files and does not need any of this).

# Hive (used for the driver query refresh)
BIGDATA_HOST=
BIGDATA_PORT=
BIGDATA_USER=
BIGDATA_PASSWORD=
BIGDATA_QUEUE=

# Presto runs on a different server/port than Hive
PRESTO_HOST=
PRESTO_PORT=

# hive | presto
SNAPSHOT_ENGINE=hive
